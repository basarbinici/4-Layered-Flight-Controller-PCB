	(text "But at I2C Fast Mode (400kHz) those pull-up's are questionable.\nRise Time = 0.85 x R x C_bus\nRise Time = 300 ns if C_bus @35-40 pF \n400kHz read time = 300ns \nthus,it exceeds."
		(exclude_from_sim no)
		(at 203.454 92.202 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "7552dd5b-e516-451f-8b14-954e496f3e3e")
	)
